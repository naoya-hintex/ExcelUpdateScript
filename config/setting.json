{
  "input": {
    "csv_folder": "data/in",
    "file_name": "sample_data.csv",
    "encoding": "utf-8",
    "delimiter": ",",
    "has_header": true,
    "start_row": 2
  },
  "output": {
    "excel_file": "data/output/dashboard.xlsx",
    "sheet_name": "データ",
    "start_cell": "A2"
  },
  "log": {
    "enable": true,
    "log_file": "logs/app.log",
    "level": "INFO",
    "format": "%(asctime)s [%(levelname)s] %(message)s"
  }
}
