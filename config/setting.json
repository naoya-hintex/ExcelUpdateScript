{
  "input": {
    "csv_folder": "data/in",
    "csv_file": "sample_data.csv",
    "encoding": "utf-8"
  },
  "output": {
    "output_folder": "data/out",
    "excel_file": "dashboard.xlsx",
    "sheet_name": "データ",
    "start_row": 0
  },
  "log": {
    "enable": true,
    "log_folder": "logs",
    "log_file": "app.log",
    "level": "INFO",
    "format": "%(asctime)s [%(levelname)s] %(message)s"
  }
}
